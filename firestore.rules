rules_version = '2';

// Punx Messenger — Firestore security rules
//
// Hierarchy:
//   super_admin  → full workspace power (manages roles, can do anything)
//   admin        → workspace-wide admin (group settings + pinning everywhere)
//   employee     → regular member (read/send in own groups + DMs + notes)
//
// Bootstrap super-admins are listed in `isBootstrapSuperAdmin()` below — these
// emails are allowed to create their /users/{uid} doc with role=super_admin on
// first sign-in. After that, role changes go through the admin panel and are
// only writable by an existing super_admin.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Helpers ─────────

    // People sign in with Google, and only Google — pinning the provider
    // matters because the email check below is the ONLY gate, and Firebase's
    // email/password provider would let anyone self-register "someone@punx.ai"
    // (createUserWithEmailAndPassword never verifies the address) and walk
    // straight through it. If another human provider is ever added, add it
    // here explicitly rather than dropping this check.
    function isHuman() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (request.auth.token.email.matches('.*@punx[.]ai$')
            || request.auth.token.email == 'perezjohnrey43@gmail.com');
    }

    // Bots authenticate with a Firebase custom token minted by the Worker
    // (see workers/src/routes/bots.js), which stamps a `bot: true` claim. A
    // claim can't be self-assigned the way an email address can, so this is
    // not a way in for anyone who hasn't been issued an API key.
    //
    // `enabled` is re-read on every request rather than trusted from the
    // token, so switching a bot off in the admin panel cuts it off within
    // seconds instead of whenever its hour-long token happens to expire.
    // The `'bot' in ...` guard is not redundant: it means this never depends
    // on how missing-key access on the token map behaves, so a human — who has
    // no such claim — short-circuits to false here with certainty, and every
    // botCan() below waves them straight through.
    function isBot() {
      return request.auth != null
        && 'bot' in request.auth.token
        && request.auth.token.bot == true
        && get(/databases/$(database)/documents/bots/$(request.auth.uid)).data.enabled == true;
    }

    function signedIn() { return isHuman() || isBot(); }

    // Gates one capability for bots and waves humans through untouched, so
    // every call site below reads as "the existing rule, plus a scope check
    // that only applies to bots". Scopes live on the bot's registry doc; the
    // admin panel is what grants them.
    function botCan(scope) {
      return !isBot()
        || scope in get(/databases/$(database)/documents/bots/$(request.auth.uid)).data.scopes;
    }

    // Admin-tier capabilities a bot can be granted. Written as their own
    // helpers because they sit alongside `isWorkspaceAdmin() ||
    // isGroupAdmin()` in existing rules, where a bare botCan() would read as
    // if it applied to humans too — these are strictly bot-only additions,
    // and always still require the bot to be a member of the group.
    function botCanManageChannels(groupId) {
      return isBot() && isGroupMember(groupId) && botCan('channels:manage');
    }
    function botCanManageMembers(groupId) {
      return isBot() && isGroupMember(groupId) && botCan('members:manage');
    }

    function myUid() { return request.auth.uid; }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(myUid())).data.role;
    }

    function isSuperAdmin()      { return signedIn() && myRole() == 'super_admin'; }
    function isWorkspaceAdmin()  { return signedIn() && (myRole() == 'admin' || myRole() == 'super_admin'); }

    function isBootstrapSuperAdmin() {
      // KEEP IN SYNC with VITE_SUPER_ADMIN_EMAILS in .env.local
      return request.auth.token.email == 'rey@punx.ai';
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }
    function isGroupAdmin(groupId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/groups/$(groupId)).data.adminUids;
    }
    // Like isGroupAdmin but works during a batch that creates the parent group.
    function isGroupAdminAfter(groupId) {
      return signedIn() &&
        myUid() in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.adminUids;
    }

    function isDmMember(convoId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/dms/$(convoId)).data.members;
    }

    function isCallMember(callId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/calls/$(callId)).data.members;
    }

    // Deliberately NOT a get() on the voiceSignals/{pairKey} doc — the
    // offerer's client attaches its candidates listener before that parent
    // doc is written (it needs the RTCPeerConnection to exist first to
    // generate the offer SDP that goes into the doc), so a get()-based check
    // denies the very first read with "missing or insufficient permissions"
    // and Firestore listeners don't recover from a permission error once
    // thrown — the listener just dies. pairKey is always the two uids sorted
    // and joined with "__" (see voicePairKey in lib/voiceChannel.js), so
    // membership is checkable straight from the path, no parent doc needed.
    function isVoicePairMember(pairKey) {
      return signedIn() && myUid() in pairKey.split('__');
    }

    // ───────── Users (workspace directory) ─────────

    match /users/{uid} {
      // Any @punx.ai signed-in user can read the directory
      allow read: if signedIn();

      // On first sign-in the client creates the user's own doc.
      // Role must default to 'employee', UNLESS the email is in the bootstrap list,
      // in which case 'super_admin' is allowed.
      allow create: if (signedIn() && uid == myUid() && (
          request.resource.data.role == 'employee'
          || (request.resource.data.role == 'super_admin' && isBootstrapSuperAdmin())
        ))
        // A bot can't create its own /users doc — it has no Firebase Auth
        // account until the first time it redeems its API key, and by then it
        // needs to already be visible as a user. So the admin registering the
        // bot writes it, at the uid the registry assigns. Always 'employee':
        // a bot's real power comes from its scopes, never from a role.
        || (isWorkspaceAdmin()
            && request.resource.data.type == 'bot'
            && request.resource.data.role == 'employee');

      // Updates:
      //   - super_admin: anything
      //   - the user themselves: anything EXCEPT role/email/uid/createdAt
      allow update: if isSuperAdmin()
        || (uid == myUid()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'email', 'uid', 'createdAt']));

      allow delete: if isSuperAdmin();

      // Private notes: only the owner
      match /notes/{noteId} {
        allow read, write: if signedIn() && uid == myUid();
      }
    }

    // ───────── Groups ─────────

    match /groups/{groupId} {
      allow read: if signedIn() && myUid() in resource.data.memberUids;

      // Any signed-in user can create a group, but they must be the owner and
      // be in both memberUids and adminUids.
      allow create: if signedIn()
        && request.resource.data.ownerUid == myUid()
        && myUid() in request.resource.data.memberUids
        && myUid() in request.resource.data.adminUids;

      // Update:
      //   - workspace admins anything
      //   - group admins anything except ownerUid
      //   - any non-owner member can self-leave (remove self from memberUids/adminUids only)
      allow update: if isWorkspaceAdmin()
        || (isGroupAdmin(groupId)
            && request.resource.data.ownerUid == resource.data.ownerUid)
        // A members:manage bot may add/remove members, but never touch
        // ownership or the admin list — it can't escalate itself or anyone
        // else into a position it wasn't granted.
        || (botCanManageMembers(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']))
        || (signedIn()
            && myUid() in resource.data.memberUids
            && resource.data.ownerUid != myUid()
            && !(myUid() in request.resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'adminUids']));

      // Delete: owner or workspace admin
      allow delete: if (signedIn() && resource.data.ownerUid == myUid())
        || isWorkspaceAdmin();

      // ───── Channel categories (Discord-style grouping) ─────
      match /categories/{categoryId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if isWorkspaceAdmin() || isGroupAdmin(groupId);
      }

      // ───── Channels ─────
      match /channels/{channelId} {
        allow read: if isGroupMember(groupId);
        // Create: group admin (incl. during batched group creation) or workspace admin
        allow create: if (isWorkspaceAdmin() || isGroupAdminAfter(groupId) || botCanManageChannels(groupId))
          && request.resource.data.type in ['text', 'voice'];
        // Update: admins anything (incl. categoryId/order for drag-to-reorder);
        // any group member may bump `lastMessageAt` (unread state) and/or
        // write to `typing` (typing indicators).
        allow update: if isWorkspaceAdmin() || isGroupAdmin(groupId) || botCanManageChannels(groupId)
          || (isGroupMember(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'typing']));
        allow delete: if isWorkspaceAdmin() || isGroupAdmin(groupId) || botCanManageChannels(groupId);

        // ───── Channel messages ─────
        match /messages/{msgId} {
          allow read: if isGroupMember(groupId);

          // Create: must be group member + author identifies the sender
          allow create: if isGroupMember(groupId)
            && request.resource.data.author.uid == myUid()
            && botCan('messages:write');

          // Update:
          //   - author can edit their own message body (text/imageURL)
          //   - group admins / workspace admins can pin/unpin (and anything)
          //   - any group member can update ONLY the `reactions` field (for emoji reactions)
          allow update: if isWorkspaceAdmin()
            || isGroupAdmin(groupId)
            || (isGroupMember(groupId) && resource.data.author.uid == myUid()
                && botCan('messages:write'))
            || (isGroupMember(groupId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                && botCan('reactions:write'))
            // Pinning is otherwise admin-only, but a bot with the react/pin
            // scope gets it too — pinning its own output is how a bot
            // acknowledges a command without posting more noise.
            || (isGroupMember(groupId) && isBot() && botCan('reactions:write')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']));

          // Delete: author, group admin, or workspace admin
          allow delete: if isWorkspaceAdmin()
            || isGroupAdmin(groupId)
            || (isGroupMember(groupId) && resource.data.author.uid == myUid()
                && botCan('messages:write'));
        }

        // ───── Voice channel roster + mesh WebRTC signaling ─────
        //
        // Discord-style multi-person voice, mesh topology (every participant
        // connects directly to every other — no media server). Doc id =
        // participant's own uid, so join is an idempotent upsert and leave is
        // a single-doc delete. Firestore has no onDisconnect() hook, so a
        // stale-heartbeat doc may be pruned by ANY group member, not just its
        // owner — see the `delete` clause below.
        match /voiceParticipants/{uid} {
          allow read: if isGroupMember(groupId);

          // botCan gates a music/utility bot joining the mesh at all; past
          // this point a bot is just another participant, and the signaling
          // below treats it identically to a browser.
          allow create: if isGroupMember(groupId) && uid == myUid()
            && request.resource.data.uid == myUid()
            && botCan('voice:join')
            && get(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)).data.type == 'voice';

          // Self-updates only: heartbeat + my own mic/deafen/camera/screen-share state.
          allow update: if isGroupMember(groupId) && uid == myUid()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastHeartbeat', 'muted', 'deafened', 'cameraOn', 'screenSharing']);

          // Self-leave, or anyone in the group may prune a doc whose
          // heartbeat is genuinely stale (server-verified via request.time).
          // 2 minutes, matching lib/voiceChannel.js's STALE_MS — keep these
          // in sync (tuned generously to tolerate browser timer throttling
          // in backgrounded tabs, not just genuine crashes/disconnects).
          // Admins are also allowed through so deleting a channel can clear
          // its roster (see deleteChannel in lib/groups.js) — otherwise a
          // still-connected participant's doc outlives the channel itself.
          allow delete: if isWorkspaceAdmin() || isGroupAdmin(groupId)
            || (isGroupMember(groupId)
                && (uid == myUid() || request.time > resource.data.lastHeartbeat + duration.value(120, 's')));
        }

        // A `voiceSignals/{pairKey}` doc carries one pair's offer/answer SDP
        // (pairKey = sorted `uidA__uidB`, same convention as dmConvoId/
        // callPairKey). No ring/accept state machine — unlike `calls/{callId}`,
        // participants just come and go, so the offerer is a deterministic
        // function of the two uids (see lib/voiceChannel.js) rather than
        // "whoever dialed." ICE candidates trickle via a subcollection, same
        // shape as `calls/{callId}/candidates`.
        match /voiceSignals/{pairKey} {
          allow read: if isGroupMember(groupId) && myUid() in resource.data.uids;

          allow create: if isGroupMember(groupId)
            && botCan('voice:join')
            && myUid() in request.resource.data.uids
            && request.resource.data.offererUid == myUid()
            && request.resource.data.uids.size() == 2
            && request.resource.data.offer != null
            && request.resource.data.answer == null;

          // Only the non-offerer may attach the answer, once.
          allow update: if isGroupMember(groupId)
            && myUid() in resource.data.uids
            && myUid() != resource.data.offererUid
            && resource.data.answer == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);

          // Either side tears the pair down when one of them leaves — plus
          // admins, so deleting the channel can clear leftover signaling.
          allow delete: if isWorkspaceAdmin() || isGroupAdmin(groupId)
            || (isGroupMember(groupId) && myUid() in resource.data.uids);

          match /candidates/{candId} {
            allow read:   if isVoicePairMember(pairKey);
            allow create: if isVoicePairMember(pairKey) && request.resource.data.from == myUid();
            allow delete: if isVoicePairMember(pairKey) || isWorkspaceAdmin() || isGroupAdmin(groupId);
          }
        }
      }
    }

    // ───────── Direct messages ─────────

    // ───────── Bot registry ─────────
    //
    // One doc per bot, id == the bot's Firebase Auth uid, so isBot()/botCan()
    // above can find it straight from request.auth.uid with no indirection.
    // Each bot also gets a matching /users/{uid} doc with type:'bot', which is
    // what makes it render as a normal author / member / voice participant
    // everywhere in the app without any component knowing about bots.
    match /bots/{botUid} {
      // Readable workspace-wide: the UI needs bot names, avatars and (later)
      // their published slash commands. Nothing secret lives on this doc.
      allow read: if signedIn();
      allow create, update, delete: if isWorkspaceAdmin();

      // Credential material, kept in a subcollection precisely so the parent
      // doc can stay readable. Write-only from the app's side — an admin sets
      // or rotates the key hash and can never read it back, and neither can
      // anyone else. The Worker reads it out-of-band using its service-account
      // credentials, which bypass these rules entirely.
      match /private/{docId} {
        allow read: if false;
        allow write: if isWorkspaceAdmin();
      }
    }

    // ───────── Custom emojis (workspace-wide) ─────────

    match /emojis/{emojiId} {
      allow read:   if signedIn();
      allow create: if isWorkspaceAdmin() && request.resource.data.createdBy == myUid();
      allow delete: if isWorkspaceAdmin();
      // No update — emojis are immutable; delete + re-create to change.
    }

    // ───────── Direct messages ─────────

    match /dms/{convoId} {
      // Read: allow reading a non-existent doc (so clients can check-then-create),
      // and reading an existing doc only if you're a member.
      allow read: if signedIn() && (resource == null || myUid() in resource.data.members);

      // Create: must be a 2-person convo that includes you
      allow create: if signedIn()
        && myUid() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && botCan('dm:write');

      // Update (lastMessageAt, lastMessageText, memberInfo): either member
      allow update: if signedIn() && myUid() in resource.data.members;

      // Delete: super_admin only (admin tool)
      allow delete: if isSuperAdmin();

      match /messages/{msgId} {
        allow read: if isDmMember(convoId);

        allow create: if isDmMember(convoId)
          && request.resource.data.author.uid == myUid()
          && botCan('dm:write');

        // Either party can pin/unpin in their DM
        allow update: if isDmMember(convoId);

        // Only the author can delete (no global unsend by counterpart)
        allow delete: if isDmMember(convoId)
          && resource.data.author.uid == myUid();
      }
    }

    // ───────── 1:1 calls (WebRTC signaling) ─────────
    //
    // A `calls/{callId}` doc carries the offer/answer SDP + state machine for
    // one 1:1 audio/video call. ICE candidates live in a subcollection (not a
    // field) since both sides trickle several independently — a field would
    // race on concurrent writes. Call docs are never deleted by rule until a
    // terminal state is reached, and are cheap enough to keep as call-history
    // afterward (client chooses whether to delete).
    //
    // Callees always *discover* an incoming call via a query on `calleeUid`/
    // `pairKey` (see src/lib/calls.js), never a blind fetch of a guessed id,
    // so — unlike `dms/{convoId}` — there's no need to allow reading a
    // non-existent doc here.

    match /calls/{callId} {
      allow read: if signedIn() && myUid() in resource.data.members;

      // Only the caller can start a call, and only in the `ringing` state
      // with a valid offer attached.
      allow create: if signedIn()
        && request.resource.data.callerUid == myUid()
        && request.resource.data.members.size() == 2
        && myUid() in request.resource.data.members
        && request.resource.data.calleeUid in request.resource.data.members
        && request.resource.data.state == 'ringing'
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.offer != null;

      // Each state transition is restricted to the side allowed to make it,
      // and to only the fields that transition should touch.
      allow update: if signedIn() && myUid() in resource.data.members && (
        // Callee accepts: attaches the answer.
        (myUid() == resource.data.calleeUid && resource.data.state == 'ringing'
          && request.resource.data.state == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'answer', 'acceptedAt']))
        // Callee declines (incl. auto-decline when busy).
        || (myUid() == resource.data.calleeUid && resource.data.state == 'ringing'
          && request.resource.data.state == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Caller cancels before answer, or times out waiting for one.
        || (myUid() == resource.data.callerUid && resource.data.state == 'ringing'
          && request.resource.data.state in ['cancelled', 'missed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Either side hangs up a connected call.
        || (resource.data.state == 'accepted' && request.resource.data.state == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Either side reports a connection failure, from any non-terminal state.
        || (request.resource.data.state == 'failed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Either side can upgrade an already-connected audio call to video
        // (one-way — no downgrade back to audio-only in v1).
        || (resource.data.state == 'accepted' && resource.data.type == 'audio'
          && request.resource.data.type == 'video'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type']))
      );

      // Only once the call has reached a terminal state — either side may
      // clean it up.
      allow delete: if signedIn() && myUid() in resource.data.members
        && resource.data.state in ['declined', 'cancelled', 'missed', 'ended', 'failed'];

      match /candidates/{candId} {
        allow read:   if isCallMember(callId);
        // Write-once, append-only — each side stamps its own uid.
        allow create: if isCallMember(callId) && request.resource.data.from == myUid();
        allow delete: if isCallMember(callId);
      }

      // A fresh SDP offer/answer round for adding a track to an
      // already-connected call (e.g. turning an audio call into video) —
      // WebRTC requires renegotiation for this, it can't reuse the original
      // offer/answer on the call doc itself. Either member may propose one;
      // only the other member may attach the answer.
      match /renegotiate/{negId} {
        allow read: if isCallMember(callId);
        allow create: if isCallMember(callId)
          && request.resource.data.from == myUid()
          && request.resource.data.answer == null;
        // Write-once answer — only by someone other than whoever proposed it.
        allow update: if isCallMember(callId)
          && resource.data.from != myUid()
          && resource.data.answer == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);
      }
    }
  }
}
