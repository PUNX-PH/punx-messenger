rules_version = '2';

// Punx Messenger — Firestore security rules
//
// Hierarchy, highest first:
//   developer    → everything super_admin has, and cannot be watched by one:
//                  groups a developer OWNS are invisible and untouchable to
//                  anyone who isn't a member. Only a developer (or the
//                  bootstrap email) may grant or revoke this role.
//   super_admin  → full workspace power (manages roles, can do anything), plus
//                  read-only oversight of every group in the workspace without
//                  being a member of it — EXCEPT developer-owned ones.
//   admin        → workspace-wide admin (group settings + pinning everywhere)
//   employee     → regular member (read/send in own groups + DMs + notes)
//   guest        → invited to specific CHANNELS only. Sees nothing in a group
//                  except channels whose allowUids lists them — see
//                  channelVisible() below. Cannot create groups.
//
// Bootstrap super-admins are listed in `isBootstrapSuperAdmin()` below — these
// emails are allowed to create their /users/{uid} doc with role=super_admin on
// first sign-in. After that, role changes go through the admin panel and are
// only writable by an existing super_admin.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Helpers ─────────

    // People sign in with Google, and only Google — pinning the provider
    // matters because the email check below is the ONLY gate, and Firebase's
    // email/password provider would let anyone self-register "someone@punx.ai"
    // (createUserWithEmailAndPassword never verifies the address) and walk
    // straight through it. If another human provider is ever added, add it
    // here explicitly rather than dropping this check.
    // Google is still the ONLY human sign-in path, and that is load-bearing:
    // it means the address on the token was verified by Google. Never widen
    // this to a provider that lets an account choose its own unverified email
    // (createUserWithEmailAndPassword does exactly that) — the internal-domain
    // check below would then be self-assertable and anyone could walk in as an
    // employee.
    function isGoogleAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // An address that belongs to the company. Token-only, no reads.
    function isInternalEmail() {
      return request.auth.token.email.matches('.*@punx[.]ai$')
        || request.auth.token.email == 'perezjohnrey43@gmail.com';
    }

    function iHaveUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Admission is EITHER an internal address, OR simply having a
    // /users/{uid} document — which is the record of having been let in.
    //
    // That second clause is what lets invited outsiders exist at all: their
    // Google address is arbitrary, so it grants them nothing, and their only
    // route to a users doc is redeeming a live invite as a `guest` (see the
    // create rule below). Existence of the doc is therefore the gate, and
    // admins revoke access by deleting it.
    //
    // isInternalEmail() is checked FIRST so staff pay no extra document read.
    function isHuman() {
      return isGoogleAccount() && (isInternalEmail() || iHaveUserDoc());
    }

    // Bots authenticate with a Firebase custom token minted by the Worker
    // (see workers/src/routes/bots.js), which stamps a `bot: true` claim. A
    // claim can't be self-assigned the way an email address can, so this is
    // not a way in for anyone who hasn't been issued an API key.
    //
    // `enabled` is re-read on every request rather than trusted from the
    // token, so switching a bot off in the admin panel cuts it off within
    // seconds instead of whenever its hour-long token happens to expire.
    // These three are split apart very deliberately, and the split is
    // load-bearing — collapsing them back into one isBot() broke voice-channel
    // joins for every human on the workspace.
    //
    // The rule that matters: an expression that ERRORS during evaluation denies
    // the whole rule, it does not evaluate to false. A human has no `bot` claim
    // and no bots/{uid} document, so any helper that reaches for either while
    // deciding "is this a bot" turns every rule it appears in into a denial for
    // real people.
    //
    // So: isBotToken() reads ONLY the token, behind an `in` guard, and never
    // performs a get(). That is what lets botCan() rule a human out without
    // touching — or needing to exist in — the registry at all.
    function isBotToken() {
      return request.auth != null
        && 'bot' in request.auth.token
        && request.auth.token.bot == true;
    }

    function botRegistration() {
      return get(/databases/$(database)/documents/bots/$(request.auth.uid)).data;
    }

    // `enabled` is re-read here on every request rather than trusted from the
    // token, so switching a bot off in the admin panel cuts it off within
    // seconds instead of whenever its hour-long token happens to expire. The
    // exists() check keeps a deleted registration from erroring instead of
    // simply denying — deleting the doc is how a bot gets revoked.
    function isRegisteredBot() {
      return isBotToken()
        && exists(/databases/$(database)/documents/bots/$(request.auth.uid))
        && botRegistration().enabled == true;
    }

    function signedIn() { return isHuman() || isRegisteredBot(); }

    // Gates one capability for bots and waves humans through untouched, so
    // every call site below reads as "the existing rule, plus a scope check
    // that only applies to bots". Note the human path short-circuits on the
    // token alone — no reads, nothing that can error. Scopes live on the bot's
    // registry doc; the admin panel is what grants them.
    function botCan(scope) {
      return !isBotToken()
        || (isRegisteredBot() && scope in botRegistration().scopes);
    }

    // Admin-tier capabilities a bot can be granted. Written as their own
    // helpers because they sit alongside `isWorkspaceAdmin() ||
    // isGroupAdmin()` in existing rules, where a bare botCan() would read as
    // if it applied to humans too — these are strictly bot-only additions,
    // and always still require the bot to be a member of the group.
    // isBotToken() first in both, so a human short-circuits out before any
    // read happens at all.
    function botCanManageChannels(groupId) {
      return isBotToken() && isRegisteredBot() && isGroupMember(groupId) && botCan('channels:manage');
    }
    function botCanManageMembers(groupId) {
      return isBotToken() && isRegisteredBot() && isGroupMember(groupId) && botCan('members:manage');
    }

    function myUid() { return request.auth.uid; }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(myUid())).data.role;
    }

    function isSuperAdmin()      { return signedIn() && myRole() == 'super_admin'; }
    function isDeveloper()       { return signedIn() && myRole() == 'developer'; }

    // Bottom of the hierarchy: a guest is a group member whose channel access
    // is explicit-only. Where an employee sees every non-private channel in
    // their groups, a guest sees ONLY channels that name them in allowUids.
    function isGuest()           { return signedIn() && myRole() == 'guest'; }

    // `developer` is the TOP role: everything super_admin can do, plus the one
    // thing it has that super_admin doesn't — its own groups are outside
    // super-admin reach. isTopTier() is the "manages the workspace itself"
    // tier (roles, bots, oversight); isWorkspaceAdmin() is the "manages groups
    // and content" tier, which developer is also part of.
    function isTopTier()         { return isDeveloper() || isSuperAdmin(); }
    function isWorkspaceAdmin()  { return signedIn() && (myRole() == 'admin' || myRole() == 'super_admin' || myRole() == 'developer'); }
    function canManageBots()     { return isWorkspaceAdmin(); }

    // True unless this write would create or alter a `developer`, in which
    // case only a developer (or the bootstrap email) may do it. Both sides are
    // checked: promoting someone TO developer, and touching someone who
    // already IS one. `in` guards because reading a missing key errors, and an
    // error denies rather than evaluating false.
    function touchesDeveloperRole() {
      return (('role' in request.resource.data) && request.resource.data.role == 'developer')
        || (('role' in resource.data) && resource.data.role == 'developer');
    }
    function developerRoleChangeAllowed() {
      return !touchesDeveloperRole() || isDeveloper() || isBootstrapSuperAdmin();
    }

    // ── The developer boundary ──
    //
    // Developer sits above super_admin, so a super admin must not be able to
    // read, edit, or delete a developer's own group, nor add themselves to one
    // (which would be reading it by another route). "A developer's own group"
    // is defined as: the group's ownerUid belongs to someone whose role is
    // developer. That definition is deliberate — it needs exactly one extra
    // document read and no schema change, so there is no flag for a super
    // admin to flip and nothing to remember when creating a group. The
    // trade-off, recorded honestly: transferring such a group to a
    // non-developer owner removes the protection.
    //
    // exists() first because a missing user doc would ERROR, and an error
    // denies the whole rule rather than evaluating false — which here would
    // lock ordinary admins out of ordinary groups.
    function ownerUidOf(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid;
    }
    function groupOwnerIsDeveloper(groupId) {
      return exists(/databases/$(database)/documents/users/$(ownerUidOf(groupId)))
        && get(/databases/$(database)/documents/users/$(ownerUidOf(groupId))).data.role == 'developer';
    }

    // Off-limits to everyone who isn't actually in it. Note there is no
    // isDeveloper() escape hatch: one developer does not get to read another
    // developer's group either.
    function outsideDeveloperGroup(groupId) {
      return groupOwnerIsDeveloper(groupId) && !isGroupMember(groupId);
    }

    // Stands in for the old workspace-admin-or-group-admin pair everywhere
    // inside a group. Same power as before, minus any reach into a developer's
    // own group. (Phrased without the literal old expression on purpose: a
    // mechanical find-and-replace across this file would otherwise rewrite
    // this comment too.)
    function adminOverGroup(groupId) {
      return isGroupAdmin(groupId)
        || (isWorkspaceAdmin() && !outsideDeveloperGroup(groupId));
    }

    // Workspace-wide READ for super admins ("oversight"): every group, channel,
    // message and voice roster, without being a member of any of it.
    //
    // Deliberately read-only, and that is the whole design. A super admin
    // overseeing a group is absent from its memberUids, so member lists, voice
    // rosters and mention pickers never show them — but that invisibility only
    // holds while they can't write, since a message, a reaction, a typing
    // indicator or a voice join would each announce them instantly. So this
    // appears ONLY on `read` rules; every write below still demands real
    // membership (message create, voiceParticipants create, the narrow
    // member-update clauses). To speak in a group, join it.
    //
    // The app mirrors this in isGhost() (src/lib/auth.jsx) and switches off the
    // composer, reactions, pinning, typing, drag-to-reorder and voice join to
    // match. Rules are what enforce the reads; the client is what preserves the
    // invisibility.
    //
    // isHuman() comes first on purpose: it reads the token only, so a bot —
    // which makes far more reads than any person does — short-circuits out
    // before either document read below happens. Bots can't hold this role
    // anyway, since the users create rule pins them to 'employee'.
    // One deliberate gap, recorded so it isn't mistaken for an oversight:
    // isWorkspaceAdmin() already grants message update/delete and channel
    // management everywhere, unconditionally, and that is left alone here.
    // Before oversight reads existed a super admin couldn't reach a group they
    // weren't in to use it; now they can. The app never offers those controls
    // while overseeing (see isGhost's call sites), so the only way to hit it is
    // a hand-written Firestore call — and a super admin who wants to act in a
    // group can simply add themselves to it in one write anyway. There is no
    // privilege boundary here to defend, only an accidental-reveal one, and the
    // client is what defends that. Narrowing those write rules to members would
    // also take moderation away from plain admins, which is a separate call.
    function canOverseeAll() {
      return isHuman() && (myRole() == 'super_admin' || myRole() == 'developer');
    }

    // Oversight of one group's CONTENTS. The group document itself stays
    // readable under canOverseeAll() alone, and that is a necessary
    // compromise rather than an oversight: listenAllGroups() in
    // src/lib/groups.js queries the collection unfiltered, and a single
    // unreadable document fails an entire Firestore list query — so denying
    // the doc would leave a super admin with no group list at all. Owner-role
    // exemption isn't expressible as a query filter, so the doc has to stay
    // readable. What that leaks is a developer-owned group's name and member
    // list; what it does not leak is a single channel, message, or voice
    // participant. The rail also filters these groups out client-side, so they
    // are not displayed either.
    function overseeGroup(groupId) {
      return canOverseeAll() && !groupOwnerIsDeveloper(groupId);
    }

    // ── Per-channel access ──
    //
    // Takes the channel's data map rather than fetching it, so the channel's
    // own read rule can pass `resource.data` for free while subcollections
    // (messages, voice roster) pass a get(). One function either way, because
    // two copies of this logic would drift and the drift would be a silent
    // information leak.
    //
    // Two independent mechanisms, deliberately:
    //   private + allowUids → a channel hidden from most of the group. Group
    //     and workspace admins still see it, same as Discord.
    //   guest role → sees ONLY channels naming them, private or not, and no
    //     admin override applies because a guest is never an admin.
    //
    // Every field read is `in`-guarded: channels created before this existed
    // have neither key, and reading a missing key ERRORS, which denies the
    // whole rule rather than evaluating false. Absent keys must read as
    // "public", or this would hide every pre-existing channel.
    function channelListsMe(ch) {
      return ('allowUids' in ch) && myUid() in ch.allowUids;
    }
    function channelIsPrivate(ch) {
      return ('private' in ch) && ch.private == true;
    }
    // Whether the channel DOCUMENT is readable. Deliberately weaker than
    // channelVisible() below, and the asymmetry is load-bearing:
    //
    // A Firestore list query is denied WHOLE if any single matched document is
    // unreadable — it does not silently drop the ones you can't see. So if
    // private channel docs were denied to ordinary members, listenChannels()
    // would fail outright for everyone in a group that has one, and there is no
    // query filter that can express "private is false OR the field is absent"
    // for the channels that predate this feature.
    //
    // A GUEST is exempt from that problem: guests only ever see channels that
    // name them, their client queries `allowUids array-contains me`, and every
    // channel a guest is granted has that field written at grant time. So the
    // guest case — the one this feature exists for — is fully enforced here,
    // with no migration.
    //
    // For ordinary members the residual is narrow and stated: they could fetch
    // a private channel's NAME directly through the API. Its messages, voice
    // roster and every write are still denied below. Closing that too would
    // mean backfilling `private` onto every existing channel first.
    function channelDocVisible(ch) {
      return !isGuest() || channelListsMe(ch);
    }

    // Whether the channel's CONTENTS are reachable — messages, voice roster,
    // and any write. This is the real boundary.
    function channelVisible(groupId, ch) {
      return (isGuest() && channelListsMe(ch))
        || (!isGuest() && (
              !channelIsPrivate(ch)
              || channelListsMe(ch)
              || adminOverGroup(groupId)
           ));
    }
    function channelDataOf(groupId, channelId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)).data;
    }
    // For use from a channel's subcollections, where `resource` is not the
    // channel. Costs one get, cached across a single request's rule evaluation.
    function canSeeChannel(groupId, channelId) {
      return channelVisible(groupId, channelDataOf(groupId, channelId));
    }

    // ── Invite links ──
    //
    // The token IS the secret: an unguessable document id, handed out as a URL.
    // Reusable until it expires or is revoked.
    function inviteDataOf(token) {
      return get(/databases/$(database)/documents/invites/$(token)).data;
    }
    function inviteIsUsable(token) {
      return token is string
        && token.size() > 0
        && exists(/databases/$(database)/documents/invites/$(token))
        && !(('revoked' in inviteDataOf(token)) && inviteDataOf(token).revoked == true)
        && ('expiresAt' in inviteDataOf(token))
        && inviteDataOf(token).expiresAt > request.time;
    }

    // The invite THIS account joined with, recorded on its own users doc as
    // `invitedVia`. Carrying it there rather than passing it per-write is what
    // lets the group/channel rules below verify a self-add: rules can't take
    // arguments from the client, but they can read a document the client wrote
    // under a rule that already validated the token.
    function myUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function iHaveLiveInvite() {
      return request.auth != null
        && iHaveUserDoc()
        && ('invitedVia' in myUserData())
        && inviteIsUsable(myUserData().invitedVia);
    }
    function myInvite() {
      return inviteDataOf(myUserData().invitedVia);
    }
    function myInviteGrantsGroup(groupId) {
      return iHaveLiveInvite() && myInvite().groupId == groupId;
    }
    function myInviteGrantsChannel(groupId, channelId) {
      return myInviteGrantsGroup(groupId) && (channelId in myInvite().channelIds);
    }

    // "This write adds exactly me to `field` and changes nothing else."
    // Written out rather than using a set difference so the absent-field case
    // (channels predating allowUids) is explicit — reading a missing key errors,
    // and an error denies.
    function addsOnlyMeTo(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.auth.uid in request.resource.data[field]
        && (
          (!(field in resource.data) && request.resource.data[field].size() == 1)
          || ((field in resource.data)
              // NOT already present is the load-bearing clause. Without it the
              // three conditions only say "I'm in the result and the list grew
              // by one" — so someone already on the list could add ONE OTHER
              // person and pass. Requiring my own absence beforehand is what
              // proves the single addition was me. A rules test caught this.
              && !(request.auth.uid in resource.data[field])
              && request.resource.data[field].hasAll(resource.data[field])
              && request.resource.data[field].size() == resource.data[field].size() + 1)
        );
    }

    function isBootstrapSuperAdmin() {
      // KEEP IN SYNC with VITE_SUPER_ADMIN_EMAILS in .env.local
      return request.auth.token.email == 'rey@punx.ai';
    }

    function isGroupMember(groupId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }
    function isGroupAdmin(groupId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/groups/$(groupId)).data.adminUids;
    }
    // Like isGroupAdmin but works during a batch that creates the parent group.
    function isGroupAdminAfter(groupId) {
      return signedIn() &&
        myUid() in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.adminUids;
    }

    function isDmMember(convoId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/dms/$(convoId)).data.members;
    }

    function isCallMember(callId) {
      return signedIn() &&
        myUid() in get(/databases/$(database)/documents/calls/$(callId)).data.members;
    }

    // Deliberately NOT a get() on the voiceSignals/{pairKey} doc — the
    // offerer's client attaches its candidates listener before that parent
    // doc is written (it needs the RTCPeerConnection to exist first to
    // generate the offer SDP that goes into the doc), so a get()-based check
    // denies the very first read with "missing or insufficient permissions"
    // and Firestore listeners don't recover from a permission error once
    // thrown — the listener just dies. pairKey is always the two uids sorted
    // and joined with "__" (see voicePairKey in lib/voiceChannel.js), so
    // membership is checkable straight from the path, no parent doc needed.
    function isVoicePairMember(pairKey) {
      return signedIn() && myUid() in pairKey.split('__');
    }

    // ───────── Users (workspace directory) ─────────

    match /users/{uid} {
      // Any @punx.ai signed-in user can read the directory
      allow read: if signedIn();

      // On first sign-in the client creates the user's own doc.
      // Role must default to 'employee', UNLESS the email is in the bootstrap list,
      // in which case 'super_admin' is allowed.
      // Internal staff creating their own doc on first sign-in. Deliberately
      // spelled out as isGoogleAccount() && isInternalEmail() rather than
      // isHuman(), because isHuman() now accepts "has a users doc" and this is
      // the rule that CREATES that doc — routing it through isHuman() would be
      // circular.
      allow create: if (isGoogleAccount() && isInternalEmail() && uid == myUid() && (
          request.resource.data.role == 'employee'
          || (request.resource.data.role == 'super_admin' && isBootstrapSuperAdmin())
        ))
        // An invited outsider redeeming a link. `guest` and nothing else: an
        // arbitrary Google address must never be able to mint itself anything
        // higher, and a guest sees only the channels it is explicitly listed
        // on. The token is validated here, and recorded so the group/channel
        // self-adds below can check it.
        || (isGoogleAccount() && uid == myUid()
            && request.resource.data.role == 'guest'
            && request.resource.data.invitedVia is string
            && inviteIsUsable(request.resource.data.invitedVia))
        // A bot can't create its own /users doc — it has no Firebase Auth
        // account until the first time it redeems its API key, and by then it
        // needs to already be visible as a user. So the admin registering the
        // bot writes it, at the uid the registry assigns. Always 'employee':
        // a bot's real power comes from its scopes, never from a role.
        || (canManageBots()
            && request.resource.data.type == 'bot'
            && request.resource.data.role == 'employee');

      // Updates:
      //   - super_admin: anything
      //   - the user themselves: anything EXCEPT role/email/uid/createdAt
      // Role administration is top-tier, but the `developer` role itself is
      // developer-only: if a super admin could promote or demote a developer,
      // the whole boundary above would be one click from being bypassed — they
      // would just demote the developer and read the group. The bootstrap
      // email is the escape hatch for creating the very first developer, since
      // otherwise nobody could ever grant it.
      allow update: if (isTopTier() && developerRoleChangeAllowed())
        || (uid == myUid()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'email', 'uid', 'createdAt']))
        // A bot's mirror /users doc has to stay in step with its registry doc —
        // updateBotProfile in src/lib/bots.js writes both — and a developer can
        // reach the registry but not, by default, anyone's /users doc. Narrowed
        // to docs that are ALREADY type:'bot' and barred from role/email/uid/
        // type, so it is not a route to editing a person or promoting anything.
        // `'type' in resource.data` guards the read: a missing key errors, and
        // an error denies the whole rule rather than evaluating to false.
        || (canManageBots()
            && 'type' in resource.data
            && resource.data.type == 'bot'
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'email', 'uid', 'createdAt', 'type']));

      // Same reasoning as the role gate above — deleting a developer's account
      // would strip the protection just as effectively as demoting them.
      allow delete: if isTopTier()
        && !(('role' in resource.data) && resource.data.role == 'developer' && !isDeveloper());

      // Private notes: only the owner
      match /notes/{noteId} {
        allow read, write: if signedIn() && uid == myUid();
      }
    }

    // ───────── Groups ─────────

    match /groups/{groupId} {
      // Membership check first — it needs no document read and is what almost
      // every request takes. canOverseeAll() is the fallback that lets a super
      // admin list groups they aren't in (listenAllGroups in src/lib/groups.js
      // queries the collection unfiltered, which is only legal because this
      // clause holds for every doc it returns).
      allow read: if (signedIn() && myUid() in resource.data.memberUids)
        || canOverseeAll();

      // Any signed-in user can create a group, but they must be the owner and
      // be in both memberUids and adminUids.
      // Guests are invited into specific channels; they don't get to spin up
      // groups of their own.
      allow create: if signedIn() && !isGuest()
        && request.resource.data.ownerUid == myUid()
        && myUid() in request.resource.data.memberUids
        && myUid() in request.resource.data.adminUids;

      // Update:
      //   - workspace admins anything
      //   - group admins anything except ownerUid
      //   - any non-owner member can self-leave (remove self from memberUids/adminUids only)
      // outsideDeveloperGroup() is what stops a super admin adding themselves
      // to a developer's group — which would otherwise be a one-write route
      // straight past the read rules below.
      allow update: if (isWorkspaceAdmin() && !outsideDeveloperGroup(groupId))
        || (isGroupAdmin(groupId)
            && request.resource.data.ownerUid == resource.data.ownerUid)
        // A members:manage bot may add/remove members, but never touch
        // ownership or the admin list — it can't escalate itself or anyone
        // else into a position it wasn't granted.
        || (botCanManageMembers(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']))
        // Redeeming an invite: add ONLY yourself to memberUids, and only while
        // the invite naming this group is still live.
        || myInviteGrantsGroup(groupId) && addsOnlyMeTo('memberUids')
        || (signedIn()
            && myUid() in resource.data.memberUids
            && resource.data.ownerUid != myUid()
            && !(myUid() in request.resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'adminUids']));

      // Delete: owner or workspace admin
      allow delete: if (signedIn() && resource.data.ownerUid == myUid())
        || (isWorkspaceAdmin() && !outsideDeveloperGroup(groupId));

      // ───── Channel categories (Discord-style grouping) ─────
      match /categories/{categoryId} {
        allow read: if isGroupMember(groupId) || overseeGroup(groupId);
        allow create, update, delete: if adminOverGroup(groupId);
      }

      // ───── Channels ─────
      match /channels/{channelId} {
        // `resource.data` is the channel itself here, so visibility costs no
        // extra read on the common path.
        allow read: if (isGroupMember(groupId) && channelDocVisible(resource.data))
          || overseeGroup(groupId);
        // Create: group admin (incl. during batched group creation) or workspace admin
        allow create: if (isGroupAdminAfter(groupId) || adminOverGroup(groupId) || botCanManageChannels(groupId))
          && request.resource.data.type in ['text', 'voice'];
        // Update: admins anything (incl. categoryId/order for drag-to-reorder);
        // any group member may bump `lastMessageAt` (unread state) and/or
        // write to `typing` (typing indicators).
        allow update: if adminOverGroup(groupId) || botCanManageChannels(groupId)
          // Redeeming an invite: add ONLY yourself to allowUids, and only for a
          // channel the invite actually names.
          || (myInviteGrantsChannel(groupId, channelId) && addsOnlyMeTo('allowUids'))
          || (isGroupMember(groupId)
              && channelVisible(groupId, resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'typing']));
        allow delete: if adminOverGroup(groupId) || botCanManageChannels(groupId);

        // ───── Channel messages ─────
        match /messages/{msgId} {
          allow read: if (isGroupMember(groupId) && canSeeChannel(groupId, channelId))
            || overseeGroup(groupId);

          // Create: must be group member + author identifies the sender.
          // Oversight is NOT enough — posting is exactly what would give an
          // overseeing super admin away, so they have to join the group first.
          allow create: if isGroupMember(groupId)
            && canSeeChannel(groupId, channelId)
            && request.resource.data.author.uid == myUid()
            && botCan('messages:write');

          // Update:
          //   - author can edit their own message body (text/imageURL)
          //   - group admins / workspace admins can pin/unpin (and anything)
          //   - any group member can update ONLY the `reactions` field (for emoji reactions)
          allow update: if adminOverGroup(groupId)
            || (isGroupMember(groupId) && canSeeChannel(groupId, channelId)
                && resource.data.author.uid == myUid()
                && botCan('messages:write'))
            || (isGroupMember(groupId) && canSeeChannel(groupId, channelId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                && botCan('reactions:write'))
            // Pinning is otherwise admin-only, but a bot with the react/pin
            // scope gets it too — pinning its own output is how a bot
            // acknowledges a command without posting more noise.
            || (isBotToken() && isRegisteredBot() && isGroupMember(groupId) && botCan('reactions:write')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']));

          // Delete: author, group admin, or workspace admin
          allow delete: if adminOverGroup(groupId)
            || (isGroupMember(groupId) && canSeeChannel(groupId, channelId)
                && resource.data.author.uid == myUid()
                && botCan('messages:write'));
        }

        // ───── Voice channel roster + mesh WebRTC signaling ─────
        //
        // Discord-style multi-person voice, mesh topology (every participant
        // connects directly to every other — no media server). Doc id =
        // participant's own uid, so join is an idempotent upsert and leave is
        // a single-doc delete. Firestore has no onDisconnect() hook, so a
        // stale-heartbeat doc may be pruned by ANY group member, not just its
        // owner — see the `delete` clause below.
        match /voiceParticipants/{uid} {
          // Readable under oversight so a super admin can see who's in a voice
          // channel. Joining it stays member-only below — a roster doc is
          // precisely the thing the rest of the group would notice.
          allow read: if (isGroupMember(groupId) && canSeeChannel(groupId, channelId))
            || overseeGroup(groupId);

          // botCan gates a music/utility bot joining the mesh at all; past
          // this point a bot is just another participant, and the signaling
          // below treats it identically to a browser.
          allow create: if isGroupMember(groupId) && uid == myUid()
            && canSeeChannel(groupId, channelId)
            && request.resource.data.uid == myUid()
            && botCan('voice:join')
            && get(/databases/$(database)/documents/groups/$(groupId)/channels/$(channelId)).data.type == 'voice';

          // Self-updates only: heartbeat + my own mic/deafen/camera/screen-share state.
          allow update: if isGroupMember(groupId) && uid == myUid()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastHeartbeat', 'muted', 'deafened', 'cameraOn', 'screenSharing']);

          // Self-leave, or anyone in the group may prune a doc whose
          // heartbeat is genuinely stale (server-verified via request.time).
          // 2 minutes, matching lib/voiceChannel.js's STALE_MS — keep these
          // in sync (tuned generously to tolerate browser timer throttling
          // in backgrounded tabs, not just genuine crashes/disconnects).
          // Admins are also allowed through so deleting a channel can clear
          // its roster (see deleteChannel in lib/groups.js) — otherwise a
          // still-connected participant's doc outlives the channel itself.
          allow delete: if adminOverGroup(groupId)
            || (isGroupMember(groupId)
                && (uid == myUid() || request.time > resource.data.lastHeartbeat + duration.value(120, 's')));
        }

        // A `voiceSignals/{pairKey}` doc carries one pair's offer/answer SDP
        // (pairKey = sorted `uidA__uidB`, same convention as dmConvoId/
        // callPairKey). No ring/accept state machine — unlike `calls/{callId}`,
        // participants just come and go, so the offerer is a deterministic
        // function of the two uids (see lib/voiceChannel.js) rather than
        // "whoever dialed." ICE candidates trickle via a subcollection, same
        // shape as `calls/{callId}/candidates`.
        match /voiceSignals/{pairKey} {
          allow read: if isGroupMember(groupId) && myUid() in resource.data.uids;

          allow create: if isGroupMember(groupId)
            && botCan('voice:join')
            && myUid() in request.resource.data.uids
            && request.resource.data.offererUid == myUid()
            && request.resource.data.uids.size() == 2
            && request.resource.data.offer != null
            && request.resource.data.answer == null;

          // Only the non-offerer may attach the answer, once.
          allow update: if isGroupMember(groupId)
            && myUid() in resource.data.uids
            && myUid() != resource.data.offererUid
            && resource.data.answer == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);

          // Either side tears the pair down when one of them leaves — plus
          // admins, so deleting the channel can clear leftover signaling.
          allow delete: if adminOverGroup(groupId)
            || (isGroupMember(groupId) && myUid() in resource.data.uids);

          match /candidates/{candId} {
            allow read:   if isVoicePairMember(pairKey);
            allow create: if isVoicePairMember(pairKey) && request.resource.data.from == myUid();
            allow delete: if isVoicePairMember(pairKey) || adminOverGroup(groupId);
          }
        }
      }
    }

    // ───────── Direct messages ─────────

    // ───────── Bot registry ─────────
    //
    // One doc per bot, id == the bot's Firebase Auth uid, so isRegisteredBot()/
    // botCan() above can find it straight from request.auth.uid, no indirection.
    // Each bot also gets a matching /users/{uid} doc with type:'bot', which is
    // what makes it render as a normal author / member / voice participant
    // everywhere in the app without any component knowing about bots.
    match /bots/{botUid} {
      // Readable workspace-wide: the UI needs bot names, avatars and (later)
      // their published slash commands. Nothing secret lives on this doc.
      allow read: if signedIn();
      allow create, update, delete: if canManageBots();

      // Credential material, kept in a subcollection precisely so the parent
      // doc can stay readable. Write-only from the app's side — an admin sets
      // or rotates the key hash and can never read it back, and neither can
      // anyone else. The Worker reads it out-of-band using its service-account
      // credentials, which bypass these rules entirely.
      match /private/{docId} {
        allow read: if false;
        allow write: if canManageBots();
      }
    }

    // ───────── Invite links ─────────
    //
    // One doc per link, id = an unguessable token. Shape:
    //   { groupId, groupName, channelIds[], channelNames[], createdBy,
    //     createdAt, expiresAt, revoked? }
    // groupName/channelNames are denormalised on purpose: someone opening the
    // link has no read access to the group yet, so the accept screen has to be
    // able to say what they're joining from this document alone.
    match /invites/{token} {
      // Single-document reads only, for ANY authenticated account — an invited
      // outsider has no users doc yet, so signedIn() would be false and they
      // could not see what they were accepting. Safe because the id is the
      // secret and `list` is refused, so nobody can enumerate invites.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if adminOverGroup(request.resource.data.groupId)
        && request.resource.data.createdBy == myUid()
        && request.resource.data.groupId is string
        && request.resource.data.channelIds is list
        && request.resource.data.expiresAt is timestamp;

      // Revoking is the ONLY permitted mutation. An existing link must never be
      // repointed at a different group or a wider channel set — anyone already
      // holding the URL would silently gain that access.
      allow update: if adminOverGroup(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']);

      allow delete: if adminOverGroup(resource.data.groupId);

      // Who used this link, for the admin UI and an audit trail. Written by the
      // joiner, doc id = their uid, so it is naturally idempotent.
      match /redemptions/{uid} {
        allow read: if adminOverGroup(inviteDataOf(token).groupId);
        allow create: if request.auth != null && uid == request.auth.uid
          && inviteIsUsable(token);
      }
    }

    // ───────── Custom emojis (workspace-wide) ─────────

    match /emojis/{emojiId} {
      allow read:   if signedIn();
      allow create: if isWorkspaceAdmin() && request.resource.data.createdBy == myUid();
      allow delete: if isWorkspaceAdmin();
      // No update — emojis are immutable; delete + re-create to change.
    }

    // ───────── Direct messages ─────────

    match /dms/{convoId} {
      // Read: allow reading a non-existent doc (so clients can check-then-create),
      // and reading an existing doc only if you're a member.
      allow read: if signedIn() && (resource == null || myUid() in resource.data.members);

      // Create: must be a 2-person convo that includes you
      allow create: if signedIn()
        && myUid() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && botCan('dm:write');

      // Update (lastMessageAt, lastMessageText, memberInfo): either member
      allow update: if signedIn() && myUid() in resource.data.members;

      // Delete: top tier only (admin tool)
      allow delete: if isTopTier();

      match /messages/{msgId} {
        allow read: if isDmMember(convoId);

        allow create: if isDmMember(convoId)
          && request.resource.data.author.uid == myUid()
          && botCan('dm:write');

        // Either party can pin/unpin in their DM
        allow update: if isDmMember(convoId);

        // Only the author can delete (no global unsend by counterpart)
        allow delete: if isDmMember(convoId)
          && resource.data.author.uid == myUid();
      }
    }

    // ───────── 1:1 calls (WebRTC signaling) ─────────
    //
    // A `calls/{callId}` doc carries the offer/answer SDP + state machine for
    // one 1:1 audio/video call. ICE candidates live in a subcollection (not a
    // field) since both sides trickle several independently — a field would
    // race on concurrent writes. Call docs are never deleted by rule until a
    // terminal state is reached, and are cheap enough to keep as call-history
    // afterward (client chooses whether to delete).
    //
    // Callees always *discover* an incoming call via a query on `calleeUid`/
    // `pairKey` (see src/lib/calls.js), never a blind fetch of a guessed id,
    // so — unlike `dms/{convoId}` — there's no need to allow reading a
    // non-existent doc here.

    match /calls/{callId} {
      allow read: if signedIn() && myUid() in resource.data.members;

      // Only the caller can start a call, and only in the `ringing` state
      // with a valid offer attached.
      allow create: if signedIn()
        && request.resource.data.callerUid == myUid()
        && request.resource.data.members.size() == 2
        && myUid() in request.resource.data.members
        && request.resource.data.calleeUid in request.resource.data.members
        && request.resource.data.state == 'ringing'
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.offer != null;

      // Each state transition is restricted to the side allowed to make it,
      // and to only the fields that transition should touch.
      allow update: if signedIn() && myUid() in resource.data.members && (
        // Callee accepts: attaches the answer.
        (myUid() == resource.data.calleeUid && resource.data.state == 'ringing'
          && request.resource.data.state == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'answer', 'acceptedAt']))
        // Callee declines (incl. auto-decline when busy).
        || (myUid() == resource.data.calleeUid && resource.data.state == 'ringing'
          && request.resource.data.state == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Caller cancels before answer, or times out waiting for one.
        || (myUid() == resource.data.callerUid && resource.data.state == 'ringing'
          && request.resource.data.state in ['cancelled', 'missed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Either side hangs up a connected call.
        || (resource.data.state == 'accepted' && request.resource.data.state == 'ended'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Either side reports a connection failure, from any non-terminal state.
        || (request.resource.data.state == 'failed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt', 'endedBy']))
        // Either side can upgrade an already-connected audio call to video
        // (one-way — no downgrade back to audio-only in v1).
        || (resource.data.state == 'accepted' && resource.data.type == 'audio'
          && request.resource.data.type == 'video'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type']))
      );

      // Only once the call has reached a terminal state — either side may
      // clean it up.
      allow delete: if signedIn() && myUid() in resource.data.members
        && resource.data.state in ['declined', 'cancelled', 'missed', 'ended', 'failed'];

      match /candidates/{candId} {
        allow read:   if isCallMember(callId);
        // Write-once, append-only — each side stamps its own uid.
        allow create: if isCallMember(callId) && request.resource.data.from == myUid();
        allow delete: if isCallMember(callId);
      }

      // A fresh SDP offer/answer round for adding a track to an
      // already-connected call (e.g. turning an audio call into video) —
      // WebRTC requires renegotiation for this, it can't reuse the original
      // offer/answer on the call doc itself. Either member may propose one;
      // only the other member may attach the answer.
      match /renegotiate/{negId} {
        allow read: if isCallMember(callId);
        allow create: if isCallMember(callId)
          && request.resource.data.from == myUid()
          && request.resource.data.answer == null;
        // Write-once answer — only by someone other than whoever proposed it.
        allow update: if isCallMember(callId)
          && resource.data.from != myUid()
          && resource.data.answer == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']);
      }
    }
  }
}
