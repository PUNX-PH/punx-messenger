# Committed rather than left to `flutter build` to generate, so the iOS
# deployment target is pinned here instead of defaulting per Flutter version.
#
# 13.0 is a floor set by this app's dependencies, not a preference:
# flutter_webrtc needs iOS 13+, and firebase_auth 5.x / firebase_core 3.x do
# too. Lowering it produces a CocoaPods resolution failure that reads as an
# unrelated version conflict, so leave it alone unless those deps change.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously, which slows every
# build for no benefit here.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # permission_handler compiles in ONLY the permissions switched on here; any
    # other is a no-op that quietly reports "denied". The app asks for exactly one
    # through it: notifications (lib/services/notification_listener_service.dart
    # and the profile sheet). Without this flag the notifications switch cannot be
    # turned on, on iOS. Camera and microphone do not go through this plugin —
    # flutter_webrtc asks for those itself — so they are deliberately not listed.
    target.build_configurations.each do |config|
      # A list, whatever the setting held before (CocoaPods usually writes a list,
      # but a plain string would have the flag glued onto it), and added once.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      defs << 'PERMISSION_NOTIFICATIONS=1' unless defs.include?('PERMISSION_NOTIFICATIONS=1')
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
    end
  end
end
