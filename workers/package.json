{
  "name": "punx-messenger-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute punx-messenger --local --file=./migrations/0001_init.sql",
