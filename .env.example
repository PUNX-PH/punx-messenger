# Copy to .env.local and fill in from Firebase console → Project settings → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email domain restriction for sign-in (without leading @)
VITE_ALLOWED_EMAIL_DOMAIN=punx.ai

# Comma-separated extra emails outside the domain who can also sign in
VITE_ALLOWED_EXTRA_EMAILS=

# Super-admin bootstrap: comma-separated emails that auto-become super_admin on first sign-in
VITE_SUPER_ADMIN_EMAILS=rey@punx.ai

# Local Firebase emulator mode. Set to 1 to point Auth + Firestore at the local
# emulators instead of the real project — useful for exercising firestore.rules
# through the real UI without touching live data, and for signing in without a
# password. Only honoured when VITE_FIREBASE_PROJECT_ID starts with "demo-";
# src/lib/firebase.js refuses to connect otherwise. Leave empty for normal dev.
#   npx firebase emulators:start --only auth,firestore --project demo-punx
#   npm run dev -- --mode emulator      (reads .env.emulator.local)
VITE_USE_EMULATORS=
